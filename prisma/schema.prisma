generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id        String    @id @default(uuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Booking {
  id              String   @id @default(uuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id])
  eventType       String
  eventDate       DateTime
  location        String
  expectedGuests  Int?
  language        String
  duration        String
  budget          String
  specialRequests String?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String?
  content   String
  rating    Int      @default(5)
  createdAt DateTime @default(now())
}
